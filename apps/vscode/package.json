{
  "name": "@goldsentry/vscode",
  "private": true,
  "version": "1.0.2",
  "displayName": "GoldSentry 积存金监控",
  "description": "在 VS Code 状态栏监控多家银行积存金实时价并做到价提醒",
  "publisher": "goldsentry",
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "install:local": "rm -rf ~/.vscode/extensions/goldsentry-vscode && mkdir -p ~/.vscode/extensions/goldsentry-vscode && cp -r package.json dist ~/.vscode/extensions/goldsentry-vscode/"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "goldsentry.refresh",
        "title": "GoldSentry: 立即刷新"
      },
      {
        "command": "goldsentry.show",
        "title": "GoldSentry: 查看全部积存金对比"
      },
      {
        "command": "goldsentry.pick",
        "title": "GoldSentry: 选择状态栏显示的积存金"
      },
      {
        "command": "goldsentry.alert",
        "title": "GoldSentry: 设置到价提醒"
      },
      {
        "command": "goldsentry.pause",
        "title": "GoldSentry: 暂停/继续轮询"
      },
      {
        "command": "goldsentry.settings",
        "title": "GoldSentry: 打开设置"
      }
    ],
    "configuration": {
      "title": "GoldSentry",
      "properties": {
        "goldsentry.intervalSeconds": {
          "type": "number",
          "default": 10,
          "description": "轮询间隔（秒），可选 5/10/30/60/120/300/600"
        },
        "goldsentry.symbol": {
          "type": "string",
          "default": "ZS",
          "enum": [
            "ZS",
            "MS",
            "GS",
            "GF",
            "XY",
            "ZX",
            "AU9999",
            "JJC"
          ],
          "description": "状态栏默认显示品种"
        },
        "goldsentry.barkKey": {
          "type": "string",
          "default": "",
          "description": "Bark device key（留空则只用 VS Code 内置通知）"
        },
        "goldsentry.barkServer": {
          "type": "string",
          "default": "https://api.day.app",
          "description": "Bark 服务器地址，自建服填自己的 https 地址"
        },
        "goldsentry.showName": {
          "type": "boolean",
          "default": true,
          "description": "状态栏是否显示品种名称"
        },
        "goldsentry.showPct": {
          "type": "boolean",
          "default": false,
          "description": "状态栏是否显示当日涨跌幅百分比"
        },
        "goldsentry.showUp": {
          "type": "boolean",
          "default": true,
          "description": "上涨时是否显示涨跌箭头（红）"
        },
        "goldsentry.showDown": {
          "type": "boolean",
          "default": true,
          "description": "下跌时是否显示涨跌箭头（绿）"
        }
      }
    }
  },
  "dependencies": {
    "@goldsentry/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
