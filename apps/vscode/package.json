{
  "name": "@goldsentry/vscode",
  "private": true,
  "version": "1.0.5",
  "displayName": "GoldSentry 积存金监控",
  "description": "在 VS Code 状态栏监控多家银行积存金实时价并做到价提醒",
  "publisher": "goldsentry",
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "install:local": "rm -rf ~/.vscode/extensions/goldsentry-vscode && mkdir -p ~/.vscode/extensions/goldsentry-vscode && cp -r package.json dist ~/.vscode/extensions/goldsentry-vscode/"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "goldsentry.refresh",
        "title": "GoldSentry: 立即刷新"
      },
      {
        "command": "goldsentry.show",
        "title": "GoldSentry: 查看全部积存金对比"
      },
      {
        "command": "goldsentry.pick",
        "title": "GoldSentry: 选择状态栏显示的积存金"
      },
      {
        "command": "goldsentry.alert",
        "title": "GoldSentry: 设置到价提醒"
      },
      {
        "command": "goldsentry.pause",
        "title": "GoldSentry: 暂停/继续轮询"
      },
      {
        "command": "goldsentry.settings",
        "title": "GoldSentry: 打开设置"
      }
    ],
    "configuration": {
      "title": "GoldSentry",
      "properties": {
        "goldsentry.intervalSeconds": {
          "type": "number",
          "default": 10,
          "description": "轮询间隔（秒），可选 5/10/30/60/120/300/600"
        },
        "goldsentry.symbol": {
          "type": "string",
          "default": "ZS",
          "enum": [
            "ZS",
            "MS",
            "GS",
            "GF",
            "XY",
            "ZX"
          ],
          "description": "状态栏默认显示品种"
        },
        "goldsentry.barkKey": {
          "type": "string",
          "default": "",
          "description": "Bark device key（留空则只用 VS Code 内置通知）"
        },
        "goldsentry.barkServer": {
          "type": "string",
          "default": "https://api.day.app",
          "description": "Bark 服务器地址，自建服填自己的 https 地址"
        },
        "goldsentry.showName": {
          "type": "boolean",
          "default": true,
          "description": "状态栏是否显示品种名称"
        },
        "goldsentry.showPct": {
          "type": "boolean",
          "default": false,
          "description": "状态栏是否显示当日涨跌幅百分比"
        },
        "goldsentry.showUp": {
          "type": "boolean",
          "default": true,
          "description": "上涨时是否显示涨跌箭头（红）"
        },
        "goldsentry.showDown": {
          "type": "boolean",
          "default": true,
          "description": "下跌时是否显示涨跌箭头（绿）"
        },
        "goldsentry.webhookUrl": {
          "type": "string",
          "default": "",
          "description": "通用 Webhook 地址（POST JSON：title/body/source/ts），留空则不推送"
        },
        "goldsentry.emailEnabled": {
          "type": "boolean",
          "default": false,
          "description": "通过 SMTP 发送邮件推送"
        },
        "goldsentry.emailHost": {
          "type": "string",
          "default": "",
          "description": "SMTP 服务器主机名，如 smtp.qq.com"
        },
        "goldsentry.emailPort": {
          "type": "number",
          "default": 465,
          "description": "SMTP 端口，465 用 SSL，587 走 STARTTLS"
        },
        "goldsentry.emailSecure": {
          "type": "boolean",
          "default": true,
          "description": "465 隐式 SSL；关闭后 587 会自动 STARTTLS"
        },
        "goldsentry.emailUser": {
          "type": "string",
          "default": "",
          "description": "SMTP 账号邮箱，留空表示不认证"
        },
        "goldsentry.emailPass": {
          "type": "string",
          "default": "",
          "description": "SMTP 密码或授权码（明文存在 VS Code 设置里，注意不要分享配置）"
        },
        "goldsentry.emailFrom": {
          "type": "string",
          "default": "",
          "description": "发件人邮箱，留空同账号"
        },
        "goldsentry.emailTo": {
          "type": "string",
          "default": "",
          "description": "收件人邮箱，多个用逗号分隔"
        },
        "goldsentry.botEnabled": {
          "type": "boolean",
          "default": false,
          "description": "启用飞书/钉钉/企业微信/Telegram 机器人推送"
        },
        "goldsentry.botType": {
          "type": "string",
          "default": "feishu",
          "enum": [
            "feishu",
            "dingtalk",
            "wecom",
            "telegram"
          ],
          "description": "机器人平台"
        },
        "goldsentry.botUrl": {
          "type": "string",
          "default": "",
          "description": "飞书/钉钉/企业微信机器人 Webhook 地址"
        },
        "goldsentry.botSecret": {
          "type": "string",
          "default": "",
          "description": "钉钉加签密钥（可选）"
        },
        "goldsentry.botToken": {
          "type": "string",
          "default": "",
          "description": "Telegram bot token"
        },
        "goldsentry.botChatId": {
          "type": "string",
          "default": "",
          "description": "Telegram chat id"
        },
        "goldsentry.digestEnabled": {
          "type": "boolean",
          "default": true,
          "description": "每天发送积存金日报"
        },
        "goldsentry.digestTime": {
          "type": "string",
          "default": "08:30",
          "description": "日报发送时间（北京时间 HH:MM）"
        },
        "goldsentry.quietEnabled": {
          "type": "boolean",
          "default": false,
          "description": "启用免打扰时段"
        },
        "goldsentry.quietStart": {
          "type": "string",
          "default": "23:00",
          "description": "免打扰开始时间（北京时间 HH:MM）"
        },
        "goldsentry.quietEnd": {
          "type": "string",
          "default": "08:00",
          "description": "免打扰结束时间（北京时间 HH:MM）"
        }
      }
    }
  },
  "dependencies": {
    "@goldsentry/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
