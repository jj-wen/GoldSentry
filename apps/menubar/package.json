{
  "name": "@goldsentry/menubar",
  "private": true,
  "version": "1.0.2",
  "description": "Mac 菜单栏积存金监控",
  "author": "GoldSentry",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:code": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs && cp src/preload.cjs src/ball-preload.cjs src/taskbar-preload.cjs src/panel.html src/panel.css src/panel.js src/ball.html src/ball.css src/ball.js src/taskbar.html src/taskbar.css src/taskbar.js dist/ && rm -rf dist/assets && cp -r assets dist/assets",
    "start": "pnpm build:code && electron .",
    "dist": "pnpm build:code && electron-builder --mac --x64 --arm64",
    "dist:win": "pnpm build:code && electron-builder --win --x64"
  },
  "dependencies": {
    "@goldsentry/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10"
  },
  "build": {
    "appId": "com.goldsentry.menubar",
    "productName": "GoldSentry",
    "directories": {
      "buildResources": "buildResources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
