{
  "name": "goldsentry",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "probe": "node scripts/probe.ts",
    "verify:display": "node scripts/verify-display.ts",
    "verify:alerts": "node scripts/verify-alerts.ts",
    "verify:health": "node scripts/verify-health.ts",
    "verify:notify": "node scripts/verify-notify.ts",
    "verify:mail": "node scripts/verify-mail.ts",
    "verify:schedule": "node scripts/verify-schedule.ts",
    "verify:vscode": "pnpm --filter @goldsentry/vscode build && node scripts/verify-vscode.cjs",
    "verify:all": "pnpm verify:display && pnpm verify:alerts && pnpm verify:health && pnpm verify:calc && pnpm verify:notify && pnpm verify:mail && pnpm verify:schedule && pnpm verify:vscode",
    "menubar": "pnpm --filter @goldsentry/menubar start",
    "menubar:dist": "pnpm --filter @goldsentry/menubar dist",
    "menubar:dist:win": "pnpm --filter @goldsentry/menubar dist:win",
    "vscode:build": "pnpm --filter @goldsentry/vscode build",
    "vscode:install": "pnpm vscode:build && node scripts/install-vscode.cjs",
    "verify:calc": "node scripts/verify-calc.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
